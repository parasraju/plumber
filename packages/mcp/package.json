{
  "name": "@parasraju/plumber-mcp",
  "version": "1.3.0",
  "description": "Plumber as an MCP server — let your AI coding agent scan repos and GitHub Actions workflows for leaked secrets, dead code, and AI slop, with fixes in plain English. Add your own checks with custom rule packs. Check one pipeline config before you commit it.",
  "main": "src/engine.js",
  "bin": {
    "plumber-mcp": "bin/plumber-mcp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "opencode",
    "ai-agents",
    "security",
    "secrets-detection",
    "code-quality",
    "linter",
    "github-actions",
    "ci-cd",
    "workflow",
    "yaml",
    "custom-rules",
    "rule-packs",
    "config-scan",
    "ci-gate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parasraju/plumber.git"
  },
  "homepage": "https://github.com/parasraju/plumber#readme",
  "bugs": {
    "url": "https://github.com/parasraju/plumber/issues"
  },
  "license": "MIT",
  "author": "Paras Raju",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "js-yaml": "^4.3.2"
  }
}
